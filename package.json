{
  "name": "frontend-nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "contracts:generate": "node scripts/contracts.mjs --generate",
    "contracts:check": "node scripts/contracts.mjs --check",
    "contracts:sync": "node scripts/contracts.mjs --sync",
    "test:contracts": "node --test tests/*.test.cjs",
    "test:node": "mkdir -p coverage && node --test --enable-source-maps --experimental-test-coverage --test-coverage-branches=60 --test-coverage-functions=60 --test-coverage-lines=60 --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.cjs",
    "test:components": "vitest run",
    "test": "npm run test:node && npm run test:components"
  },
  "dependencies": {
    "@mairie360/bff-settings-openapi": "1.1.0",
    "@mairie360/lib-components": "0.3.0",
    "next": "16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jest-axe": "11.0.0",
    "jsdom": "29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
